APP_NAME="Fleet Tracking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Tenant Identity ───────────────────────────────────────────────────────────
# Set these per instance. APP_TENANT_ID must match the tenant's id on the
# central platform — it is used to build the Soketi channel names.
APP_TENANT_SLUG=your-tenant-slug
APP_TENANT_ID=

# ── Tenant API Token ──────────────────────────────────────────────────────────
# Scoped Sanctum token issued by the central platform (devices.read +
# signals.read). This is the ONLY platform credential this app needs:
#   1. One-time device load:   php artisan tenant:sync-devices
#   2. Soketi channel auth for the background listener and the browser map.
TENANT_API_TOKEN=
PLATFORM_API_URL=https://api.track-any-device.com

# ── Local Database (standalone) ───────────────────────────────────────────────
# server-tenant owns its own data: users, devices, signals, incidents all
# live in this SQLite file. No connection to the central MySQL.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite   # defaults to database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Offline Threshold ─────────────────────────────────────────────────────────
# Current-state only — no incidents. The listener flips a device offline after
# this many minutes of silence (the public page reads online/offline from it).
TENANT_OFFLINE_AFTER_MINUTES=15

# ── Tenant Websocket (central Soketi) ─────────────────────────────────────────
# Used by the background signal listener and by the browser live map.
BROADCAST_CONNECTION=pusher
PUSHER_APP_KEY=
PUSHER_HOST=
PUSHER_PORT=6001
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="portal@track-any-device.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug
