APP_NAME="Fleet Tracking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Tenant Identity ───────────────────────────────────────────────────────────
# Set these per container. Every tenant gets unique values.
APP_TENANT_SLUG=your-tenant-slug
APP_TENANT_ID=
APP_TENANT_API_KEY=

# Must be "tenant" — tells SsoClientServiceProvider which OAuth client to load.
APP_SURFACE=tenant

# ── Central Platform Connections ──────────────────────────────────────────────
PLATFORM_API_URL=https://api.track-any-device.com
PLATFORM_SSO_URL=https://login.track-any-device.com

# ── SSO OAuth2 Client (tenant-specific) ───────────────────────────────────────
# Generated when the tenant is approved. Copy from the admin panel — shown once.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://{APP_TENANT_SLUG}.track-any-device.com/sso/callback

# ── No local database needed ──────────────────────────────────────────────────
# server-tenant has NO local database. All data flows through the central
# app/ REST API (PLATFORM_API_URL). Sessions are stored in Redis.
# User authentication queries the central MySQL via UsesCentralConnection.
#
# DB_* vars below are for the CENTRAL database — needed only because
# the User model (UsesCentralConnection) authenticates against it directly.
# Hosted containers: point at the shared MySQL service.
# On-premise: connect to the platform's MySQL over the network (or VPN).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=

# ── Sessions & Cache (Redis — no local database tables needed) ────────────────
# Sessions go into Redis, scoped per tenant by the SESSION_COOKIE name.
# Redis is already part of the central platform infrastructure.
SESSION_DRIVER=redis
SESSION_COOKIE=tenant_slug_session   # change "slug" to APP_TENANT_SLUG
SESSION_LIFETIME=120
SESSION_DOMAIN=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Prefix isolates this tenant's keys within the shared Redis instance.
REDIS_PREFIX=tenant_slug:            # change "slug" to APP_TENANT_SLUG

CACHE_STORE=redis
QUEUE_CONNECTION=sync

# ── Broadcasting / Real-time ──────────────────────────────────────────────────
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=6001
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_PLATFORM_API_URL="${PLATFORM_API_URL}"

GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="portal@track-any-device.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug
