APP_NAME="Fleet Tracking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Tenant Identity ───────────────────────────────────────────────────────────
# Set these per container. Every tenant gets unique values.
# APP_TENANT_SLUG is used for session cookie naming, cache prefixing, and logging.
# APP_TENANT_ID must match the tenant's id in the central platform database.
APP_TENANT_SLUG=your-tenant-slug
APP_TENANT_ID=

# Machine API key issued by the central platform when this tenant was registered.
# Generated once, stored hashed centrally. Treat like a password — never commit.
APP_TENANT_API_KEY=

# Must be "tenant" — tells SsoClientServiceProvider which OAuth client to load.
APP_SURFACE=tenant

# ── Central Platform Connections ──────────────────────────────────────────────
# Point these at the central Track Any Device platform.
# On-premise deployments: change these to the platform's public URLs.
PLATFORM_API_URL=https://api.track-any-device.com
PLATFORM_SSO_URL=https://login.track-any-device.com

# ── SSO OAuth2 Client (tenant-specific) ───────────────────────────────────────
# Generated automatically when the tenant is approved in the admin panel.
# Retrieved from the "Portal API Keys" tab on the Tenant page in Filament.
# The central admin panel shows these once — copy them here before deploying.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Redirect URI must match the callback URL registered in the platform.
# Format: https://{APP_TENANT_SLUG}.track-any-device.com/sso/callback
SSO_REDIRECT_URI=

# ── Local Database ────────────────────────────────────────────────────────────
# Stores only sessions, cache, and tenant_config (branding/feature flags).
# Use sqlite for simple hosted deployments, mysql for on-premise production.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tenant_portal
# DB_USERNAME=tenant
# DB_PASSWORD=

SESSION_DRIVER=database
# Cookie name is tenant-scoped to avoid conflict between tenant portal instances.
# Change "slug" to the actual APP_TENANT_SLUG value.
SESSION_COOKIE=tenant_slug_session
SESSION_LIFETIME=120
SESSION_DOMAIN=

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── Broadcasting / Real-time ──────────────────────────────────────────────────
# Connect to the CENTRAL Soketi instance.
# Tenants do not run their own WebSocket server.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=6001
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_PLATFORM_API_URL="${PLATFORM_API_URL}"

# Google Maps — for live map, beat polygon editor, location playback.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"
VITE_GOOGLE_MAPS_LIBRARIES=

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="portal@track-any-device.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
